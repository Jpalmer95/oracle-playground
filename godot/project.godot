; Engine configuration file.
; Oracle Playground — Godot 4.7.1 + Jolt + OpenXR
config_version=5

[application]

config/name="Oracle Playground"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AgentView="*res://scripts/agent_view.gd"
MaterialLab="*res://scripts/materials.gd"
ToolRegistry="*res://scripts/tool_registry.gd"
OracleBuilder="*res://scripts/builder.gd"
Radio="*res://scripts/radio.gd"
HUDMenu="*res://scripts/hud_menu.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="props"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=10
jolt_physics_3d/simulation/position_steps=2

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/default_action_map="res://openxr_action_map.tres"
openxr/startup_alert=false
shaders/enabled=true
